# Copiare questo file in .env e sostituire entrambi i segnaposto.
DATA_DIR=/data
ADMIN_USERNAME=organizzatore
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
COOKIE_SECURE=false
# Percorso della cartella sul NAS dove conservare le statistiche del contatore vita.
# Deve essere scrivibile dall'UID/GID 10001 del container.
LIFE_STATS_HOST_PATH=./life-stats
LIFE_STATS_DIR=/data/life
